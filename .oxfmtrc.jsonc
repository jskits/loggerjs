{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    ".turbo/**",
    "**/*.md",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    // Wire-format golden files hold exact codec output and must stay byte-for-byte.
    "packages/*/test/golden/**",
  ],
}
